# Copy to .env for local dev (python-dotenv loads it automatically).
# On Railway, set these as Variables in the service settings instead.

# Optional: Postgres connection string from Railway's Postgres plugin.
# If unset, falls back to a local SQLite file at backend/data/niftyscout.db
# (fine for local dev; use Postgres in production so history survives redeploys).
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# Comma-separated list of allowed dashboard origins for CORS.
# Set this to your Vercel URL(s) once deployed, e.g.:
# FRONTEND_ORIGIN=https://nifty-breakout-scout.vercel.app
FRONTEND_ORIGIN=*

# Telegram alerts (optional, same as the CLI tool):
# NIFTYSCOUT_TG_TOKEN=123456:ABC-your-token
# NIFTYSCOUT_TG_CHAT_ID=123456789
